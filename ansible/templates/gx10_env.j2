# ==========================================
# GX10 Environment Configuration (Auto-generated by Ansible)
# Mode: {{ target_mode | default('kombi') }}
# ==========================================

# Huggingface
HF_TOKEN={{ hf_token }}
HF_HOME={{ hf_home }}
MODELS_EXTSSD={{ models_extssd }}

# Garage
GARAGE_ADMIN_TOKEN={{ garage_admin_token }}

# S3 Credentials für SDK libs/storage
S3_KEY={{ s3_key }}
S3_SECRET={{ s3_secret }}
S3_ENDPOINT=http://{{ s3_endpoint_ip }}:9000
S3_BUCKET_NAME={{ s3_bucket_name }}

# Docling Service Configuration
DOCLING_WORKERS={{ docling_workers | default(2) }}

# Infinity Embedding & Reranker Configuration
INFINITY_EMBEDDING_MODEL={{ infinity_embedding_model | default('BAAI/bge-m3') }}
INFINITY_RERANKER_MODEL={{ infinity_reranker_model | default('BAAI/bge-reranker-v2-m3') }}
INFINITY_BATCH_SIZE={{ infinity_batch_size | default(32) }}

# vLLM Service Configuration (Grace Blackwell / FP4)
VLLM_MODEL={{ vllm_model | default('RedHatAI/Qwen3-8B-NVFP4') }}
VLLM_KV_CACHE_MEM_UTIL={{ vllm_kv_cache_mem_util | default(0.85) }}
VLLM_MAX_MODEL_LEN={{ vllm_max_model_len | default(65536) }}

